<script>

"use strict";


/* ==================================================
   JARVIS + ON DEVICE LAS
   Llama 3.2 3B
   OpenAI Compatible API
================================================== */


/* ==================================================
   ELEMENTY
================================================== */

const core =
    document.getElementById("core");

const status =
    document.getElementById("status");

const response =
    document.getElementById("response");

const recognized =
    document.getElementById("recognized");

const textBox =
    document.getElementById("textBox");

const sendButton =
    document.getElementById("sendButton");

const micButton =
    document.getElementById("micButton");

const diagnostics =
    document.getElementById("diagnostics");


/* ==================================================
   KONFIGURACE LAS
================================================== */

/*
 * URL z tvého screenshotu.
 *
 * Pokud se IP iPhonu později změní,
 * napiš do JARVISe:
 *
 * /nastaveni
 */

const DEFAULT_API_BASE =
    "http://192.168.110.101:11434/v1";


let API_BASE =
    localStorage.getItem("jarvis_api_base") ||
    DEFAULT_API_BASE;


let API_KEY =
    localStorage.getItem("jarvis_api_key") ||
    "";


let MODEL =
    localStorage.getItem("jarvis_model") ||
    "";


/* ==================================================
   JARVIS OSOBNOST
================================================== */

const SYSTEM_PROMPT = `
Jsi JARVIS, osobní AI asistent uživatele.

Komunikuj především česky.
Odpovídej přirozeně, stručně a srozumitelně.
Uživatel může psát hovorovou češtinou nebo s chybami.
Snaž se správně pochopit význam jeho zprávy.

Nikdy nepředstírej, že jsi provedl akci, kterou jsi skutečně neprovedl.

Pokud uživatel položí jednoduchou otázku,
odpověz přímo a bez zbytečně dlouhého vysvětlování.

Pokud potřebuje podrobný návod,
rozepiš ho krok za krokem.

Jsi lokální JARVIS běžící na iPhonu.
Model je Llama 3.2 3B.

Pamatuj si kontext aktuální konverzace.
`;


/* ==================================================
   PAMĚŤ
================================================== */

let conversation = [];


try {

    const saved =
        localStorage.getItem(
            "jarvis_conversation"
        );

    if (saved) {

        const parsed =
            JSON.parse(saved);

        if (Array.isArray(parsed)) {

            conversation =
                parsed.slice(-20);

        }

    }

} catch (error) {

    console.warn(
        "Paměť se nepodařilo načíst."
    );

}


function saveMemory() {

    try {

        conversation =
            conversation.slice(-20);

        localStorage.setItem(
            "jarvis_conversation",
            JSON.stringify(
                conversation
            )
        );

    } catch (error) {

        log(
            "Paměť se nepodařilo uložit: " +
            error.message,
            "warn"
        );

    }

}


/* ==================================================
   DIAGNOSTIKA
================================================== */

function log(message, type = "") {

    const line =
        document.createElement("div");

    const time =
        new Date().toLocaleTimeString(
            "cs-CZ"
        );

    line.textContent =
        "[" +
        time +
        "] " +
        message;

    if (type === "error") {

        line.className =
            "diag-error";

    }

    if (type === "ok") {

        line.className =
            "diag-ok";

    }

    if (type === "warn") {

        line.className =
            "diag-warn";

    }

    diagnostics.appendChild(line);

    diagnostics.scrollTop =
        diagnostics.scrollHeight;

    console.log(
        "[JARVIS]",
        message
    );

}


/* ==================================================
   JAVASCRIPT CHYBY
================================================== */

window.addEventListener(
    "error",
    event => {

        log(
            "JS ERROR: " +
            event.message +
            " | řádek " +
            event.lineno,
            "error"
        );

    }
);


/* ==================================================
   PROMISE CHYBY
================================================== */

window.addEventListener(
    "unhandledrejection",
    event => {

        const reason =
            event.reason;

        log(
            "PROMISE ERROR: " +
            (
                reason?.message ||
                String(reason)
            ),
            "error"
        );

    }
);


/* ==================================================
   KULIČKA
================================================== */

let rotation1 = 0;

let rotation2 = 0;

let lastTime =
    performance.now();


function animate(time) {

    const delta =
        (time - lastTime) / 1000;

    lastTime =
        time;


    rotation1 +=
        45 * delta;

    rotation2 -=
        72 * delta;


    const pulse =
        1 +
        Math.sin(
            time / 1000 *
            Math.PI *
            0.55
        ) *
        0.05;


    core.style.setProperty(
        "--r1",
        rotation1 + "deg"
    );

    core.style.setProperty(
        "--r2",
        rotation2 + "deg"
    );

    core.style.setProperty(
        "--pulse",
        pulse
    );


    requestAnimationFrame(
        animate
    );
}


requestAnimationFrame(
    animate
);


/* ==================================================
   STATUS ANIMACE
================================================== */

function thinkingAnimation() {

    let dots = 0;

    status.textContent =
        "PŘEMÝŠLÍM";

    const timer =
        setInterval(() => {

            if (
                status.textContent !==
                "PŘEMÝŠLÍM"
            ) {

                clearInterval(timer);

                return;

            }

            dots =
                (dots + 1) % 4;

            status.textContent =
                "PŘEMÝŠLÍM" +
                ".".repeat(dots);

        }, 400);

}


/* ==================================================
   URL NORMALIZACE
================================================== */

function normalizeBaseUrl(url) {

    return url
        .trim()
        .replace(/\/+$/, "");

}


/* ==================================================
   API HEADERS
================================================== */

function apiHeaders() {

    const headers = {

        "Content-Type":
            "application/json"

    };


    if (API_KEY) {

        headers[
            "Authorization"
        ] =
            "Bearer " +
            API_KEY;

    }


    return headers;

}


/* ==================================================
   ZJIŠTĚNÍ MODELU
================================================== */

async function detectModel() {

    try {

        log(
            "Zjišťuji dostupné modely..."
        );


        const url =
            API_BASE +
            "/models";


        const result =
            await fetch(
                url,
                {
                    method: "GET",
                    headers: apiHeaders()
                }
            );


        if (!result.ok) {

            throw new Error(
                "HTTP " +
                result.status
            );

        }


        const data =
            await result.json();


        if (
            data &&
            Array.isArray(data.data) &&
            data.data.length > 0
        ) {

            MODEL =
                data.data[0].id;

            localStorage.setItem(
                "jarvis_model",
                MODEL
            );


            log(
                "Model nalezen: " +
                MODEL,
                "ok"
            );


            return MODEL;

        }


        throw new Error(
            "API nevrátilo žádný model."
        );

    } catch (error) {

        log(
            "MODEL ERROR: " +
            error.message,
            "error"
        );

        return null;

    }

}


/* ==================================================
   TEST SERVERU
================================================== */

async function checkServer() {

    status.textContent =
        "KONTROLA API";


    try {

        log(
            "Kontroluji LAS API..."
        );


        const result =
            await fetch(
                API_BASE +
                "/models",
                {
                    method: "GET",
                    headers: apiHeaders()
                }
            );


        if (!result.ok) {

            throw new Error(
                "HTTP " +
                result.status
            );

        }


        const data =
            await result.json();


        log(
            "LAS API odpovídá.",
            "ok"
        );


        if (
            data?.data?.length
        ) {

            MODEL =
                data.data[0].id;


            localStorage.setItem(
                "jarvis_model",
                MODEL
            );


            log(
                "Aktivní model: " +
                MODEL,
                "ok"
            );

        }


        status.textContent =
            "JARVIS PŘIPRAVEN";


        response.textContent =
            "Systém JARVIS je připraven.";

        return true;

    } catch (error) {

        status.textContent =
            "API OFFLINE";


        response.textContent =
            "Nemohu se připojit k lokálnímu AI serveru.";


        log(
            "LAS CONNECTION ERROR: " +
            error.message,
            "error"
        );


        log(
            "API: " +
            API_BASE,
            "warn"
        );


        log(
            "Zkontroluj, že LAS běží a iPhone je na stejné síti.",
            "warn"
        );


        return false;

    }

}


/* ==================================================
   HLAVNÍ CHAT
================================================== */

async function askJarvis(text) {

    if (!text.trim())
        return;


    if (!API_KEY) {

        await configureJarvis();

        if (!API_KEY) {

            response.textContent =
                "API klíč není nastaven.";

            return;

        }

    }


    recognized.textContent =
        text;


    thinkingAnimation();


    response.textContent =
        "Přemýšlím…";


    sendButton.disabled =
        true;

    micButton.disabled =
        true;


    try {

        if (!MODEL) {

            await detectModel();

        }


        if (!MODEL) {

            throw new Error(
                "Nebyl nalezen žádný model."
            );

        }


        const messages = [

            {
                role:
                    "system",

                content:
                    SYSTEM_PROMPT
            },

            ...conversation,

            {
                role:
                    "user",

                content:
                    text
            }

        ];


        log(
            "Odesílám dotaz do Llama 3.2 3B..."
        );


        const result =
            await fetch(
                API_BASE +
                "/chat/completions",
                {
                    method: "POST",

                    headers:
                        apiHeaders(),

                    body:
                        JSON.stringify({

                            model:
                                MODEL,

                            messages:
                                messages,

                            temperature:
                                0.7,

                            max_tokens:
                                1024,

                            stream:
                                false

                        })

                }
            );


        if (!result.ok) {

            let errorText =
                "HTTP " +
                result.status;


            try {

                const errorData =
                    await result.json();

                errorText +=
                    " - " +
                    (
                        errorData?.error?.message ||
                        JSON.stringify(
                            errorData
                        )
                    );

            } catch (_) {}


            throw new Error(
                errorText
            );

        }


        const data =
            await result.json();


        const answer =
            data
                ?.choices
                ?.0
                ?.message
                ?.content
                ?.trim();


        if (!answer) {

            throw new Error(
                "Model vrátil prázdnou odpověď."
            );

        }


        response.textContent =
            answer;


        conversation.push({

            role:
                "user",

            content:
                text

        });


        conversation.push({

            role:
                "assistant",

            content:
                answer

        });


        saveMemory();


        status.textContent =
            "JARVIS PŘIPRAVEN";


        log(
            "Odpověď přijata.",
            "ok"
        );


    } catch (error) {

        status.textContent =
            "CHYBA API";


        response.textContent =
            "Nepodařilo se získat odpověď.\n\n" +
            error.message;


        log(
            "CHAT ERROR: " +
            error.message,
            "error"
        );

    } finally {

        sendButton.disabled =
            false;

        micButton.disabled =
            false;

    }

}


/* ==================================================
   NASTAVENÍ
================================================== */

async function configureJarvis() {

    const currentUrl =
        API_BASE;


    const newUrl =
        prompt(
            "JARVIS – LAN API URL\n\n" +
            "Aktuální:\n" +
            currentUrl +
            "\n\n" +
            "Zadej URL LAS serveru:",
            currentUrl
        );


    if (
        newUrl === null
    ) {

        return;

    }


    if (
        !newUrl.trim()
    ) {

        return;

    }


    API_BASE =
        normalizeBaseUrl(
            newUrl
        );


    localStorage.setItem(
        "jarvis_api_base",
        API_BASE
    );


    const newKey =
        prompt(
            "JARVIS – API KEY\n\n" +
            "Zadej nový API klíč z LAS.\n" +
            "Klíč se uloží pouze lokálně v tomto prohlížeči:"
        );


    if (
        newKey === null
    ) {

        return;

    }


    if (
        !newKey.trim()
    ) {

        API_KEY = "";

        localStorage.removeItem(
            "jarvis_api_key"
        );

        return;

    }


    API_KEY =
        newKey.trim();


    localStorage.setItem(
        "jarvis_api_key",
        API_KEY
    );


    MODEL = "";

    localStorage.removeItem(
        "jarvis_model"
    );


    log(
        "API konfigurace uložena.",
        "ok"
    );


    await checkServer();

}


/* ==================================================
   PŘÍKAZY
================================================== */

async function handleCommand(text) {

    const command =
        text
            .trim()
            .toLowerCase();


    if (
        command ===
        "/nastaveni"
    ) {

        await configureJarvis();

        return true;

    }


    if (
        command ===
        "/reset"
    ) {

        conversation = [];

        localStorage.removeItem(
            "jarvis_conversation"
        );


        response.textContent =
            "Paměť konverzace byla vymazána.";


        status.textContent =
            "JARVIS PŘIPRAVEN";


        log(
            "Konverzační paměť vymazána.",
            "ok"
        );


        return true;

    }


    if (
        command ===
        "/model"
    ) {

        if (!MODEL) {

            await detectModel();

        }


        response.textContent =
            "Aktivní model:\n" +
            (
                MODEL ||
                "nezjištěn"
            );


        return true;

    }


    if (
        command ===
        "/test"
    ) {

        await checkServer();

        return true;

    }


    if (
        command ===
        "/help" ||
        command ===
        "/pomoc"
    ) {

        response.textContent =
            "JARVIS příkazy:\n\n" +
            "/nastaveni – API URL a klíč\n" +
            "/test – test LAS serveru\n" +
            "/model – zobrazí model\n" +
            "/reset – smaže paměť";


        return true;

    }


    return false;

}


/* ==================================================
   TEXTOVÝ VSTUP
================================================== */

async function handleText(text) {

    text =
        text.trim();


    if (!text)
        return;


    const commandHandled =
        await handleCommand(
            text
        );


    if (
        commandHandled
    ) {

        return;

    }


    await askJarvis(
        text
    );

}


/* ==================================================
   SEND
================================================== */

sendButton.addEventListener(
    "click",
    async () => {

        const text =
            textBox.value.trim();


        if (!text)
            return;


        textBox.value =
            "";


        textBox.style.height =
            "auto";


        await handleText(
            text
        );

    }
);


/* ==================================================
   ENTER
================================================== */

textBox.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Enter" &&
            !event.shiftKey
        ) {

            event.preventDefault();

            sendButton.click();

        }

    }
);


/* ==================================================
   TEXTAREA AUTO HEIGHT
================================================== */

textBox.addEventListener(
    "input",
    () => {

        textBox.style.height =
            "auto";

        textBox.style.height =
            Math.min(
                textBox.scrollHeight,
                110
            ) + "px";

    }
);


/* ==================================================
   SPEECH RECOGNITION
================================================== */

const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;


let recognition =
    null;


let isListening =
    false;


if (SpeechRecognition) {

    log(
        "Speech Recognition API nalezeno.",
        "ok"
    );


    recognition =
        new SpeechRecognition();


    recognition.lang =
        "cs-CZ";


    recognition.continuous =
        false;


    recognition.interimResults =
        true;


    recognition.onstart =
    () => {

        isListening =
            true;


        status.textContent =
            "POSLOUCHÁM";


        micButton.classList.add(
            "listening"
        );


        log(
            "Mikrofon spuštěn.",
            "ok"
        );

    };


    recognition.onresult =
    event => {

        let text = "";


        for (
            let i = event.resultIndex;
            i < event.results.length;
            i++
        ) {

            text +=
                event.results[i][0]
                    .transcript;

        }


        text =
            text.trim();


        if (text) {

            recognized.textContent =
                text;


            /*
             * Když je výsledek finální,
             * automaticky ho odešleme.
             */

            const lastResult =
                event.results[
                    event.results.length - 1
                ];


            if (
                lastResult.isFinal
            ) {

                textBox.value =
                    text;


                textBox.style.height =
                    "auto";


                handleText(
                    text
                );

            }

        }

    };


    recognition.onend =
    () => {

        isListening =
            false;


        micButton.classList.remove(
            "listening"
        );


        if (
            status.textContent ===
            "POSLOUCHÁM"
        ) {

            status.textContent =
                "JARVIS PŘIPRAVEN";

        }


        log(
            "Mikrofon ukončen."
        );

    };


    recognition.onerror =
    event => {

        isListening =
            false;


        micButton.classList.remove(
            "listening"
        );


        status.textContent =
            "CHYBA MIKROFONU";


        log(
            "MIC ERROR: " +
            event.error,
            "error"
        );

    };

} else {

    log(
        "Speech Recognition není v tomto prohlížeči dostupné.",
        "warn"
    );

}


/* ==================================================
   MIKROFON BUTTON
================================================== */

micButton.addEventListener(
    "click",
    () => {

        if (!recognition) {

            response.textContent =
                "Diktování není v tomto prohlížeči dostupné.";

            return;

        }


        if (isListening) {

            recognition.stop();

        } else {

            try {

                recognition.start();

            } catch (error) {

                log(
                    "MIC START ERROR: " +
                    error.message,
                    "error"
                );

            }

        }

    }
);


/* ==================================================
   HLASOVÁ ODPOVĚĎ
================================================== */

/*
 * Dvojité klepnutí na odpověď =
 * přečtení odpovědi nahlas.
 */

response.addEventListener(
    "dblclick",
    () => {

        const text =
            response.textContent.trim();


        if (
            !text ||
            !("speechSynthesis" in window)
        ) {

            return;

        }


        speechSynthesis.cancel();


        const utterance =
            new SpeechSynthesisUtterance(
                text
            );


        utterance.lang =
            "cs-CZ";


        utterance.rate =
            0.95;


        utterance.pitch =
            0.9;


        speechSynthesis.speak(
            utterance
        );


        log(
            "JARVIS odpověď čte nahlas.",
            "ok"
        );

    }
);


/* ==================================================
   START
================================================== */

async function startJarvis() {

    log(
        "JARVIS se spouští..."
    );


    log(
        "Design JARVIS CORE: OK",
        "ok"
    );


    log(
        "Lokální API: " +
        API_BASE
    );


    log(
        "WebLLM: VYPNUTO"
    );


    log(
        "Externí AI import: VYPNUTO"
    );


    log(
        "Model download: VYPNUTO"
    );


    if (!API_KEY) {

        status.textContent =
            "NASTAVENÍ";


        response.textContent =
            "JARVIS potřebuje API klíč LAS.\n\n" +
            "Otevři nastavení příkazem /nastaveni.";


        log(
            "API klíč zatím není nastaven.",
            "warn"
        );


        return;

    }


    await checkServer();

}


startJarvis();

